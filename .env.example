# Modelo do arquivo .env (copie para .env e ajuste).
# Todas as variáveis lidas por config/settings.py. Valores de exemplo, para desenvolvimento.
# Produção: veja docs/operacao.md.

# --- Django ---
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
# Separados por vírgula ou espaço
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Links do e-mail de redefinição de senha ---
SITE_DOMAIN=127.0.0.1:8000
SITE_PROTOCOL=http

# --- Segurança (produção, atrás de proxy HTTPS) ---
# Com DEBUG=False e sem esta variável, vale só https://<SITE_DOMAIN>
CSRF_TRUSTED_ORIGINS=
# Nome do cabeçalho como no request.META, vírgula, valor. Ex.: HTTP_X_FORWARDED_PROTO,https
SECURE_PROXY_SSL_HEADER=
USE_X_FORWARDED_HOST=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
# Só têm efeito com DEBUG=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- Banco PostgreSQL (atenção: porta padrão do projeto é 5433) ---
DB_NAME=romaneios
DB_USER=romaneios
DB_PASSWORD=troque-esta-senha
DB_HOST=localhost
DB_PORT=5433
DB_CONN_MAX_AGE=600

# --- E-mail ---
# Desenvolvimento: imprime os e-mails no terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Produção (SMTP), por exemplo:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.exemplo.com.br
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=Romaneios <no-reply@exemplo.com.br>
SERVER_EMAIL=no-reply@exemplo.com.br
